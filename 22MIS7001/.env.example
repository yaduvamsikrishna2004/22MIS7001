# Shared logging
LOG_API_BASE_URL=https://log-gateway.example.internal
LOG_API_TIMEOUT_MS=2500
LOG_API_MAX_RETRIES=2
LOG_API_RETRY_DELAY_MS=150
LOG_API_AUTH_ENDPOINT=/auth/token
LOG_API_CLIENT_ID=replace-me
LOG_API_CLIENT_SECRET=replace-me

# Backend runtime
BE_PORT=8080
BE_NODE_ENV=development
BE_SERVICE_NAME=notification-app-be
BE_FEED_CACHE_TTL_SECONDS=30
BE_UNREAD_CACHE_TTL_SECONDS=15
BE_RECONNECT_WINDOW_SECONDS=30
BE_MAX_RECONNECT_ATTEMPTS=6
BE_SLOW_QUERY_THRESHOLD_MS=400
BE_DELTA_SYNC_HARD_LIMIT=200

# Backend auth bootstrap (server-side only; do not expose to frontend)
EVALUATION_API_BASE_URL=https://api.example.com
EVALUATION_AUTH_PATH=/evaluation-service/auth
EVALUATION_AUTH_TIMEOUT_MS=7000
ACCESS_CODE=replace-with-access-code
CLIENT_ID=replace-with-client-id
CLIENT_SECRET=replace-with-client-secret
AUTH_BOOTSTRAP_EMAIL=replace-with-email@example.com
AUTH_BOOTSTRAP_NAME=replace-with-name
AUTH_BOOTSTRAP_ROLL_NO=replace-with-roll-no
FRONTEND_NOTIFICATION_API_URL=https://api.example.com

# Frontend runtime
VITE_NOTIFICATION_API_URL=http://4.224.186.213/evaluation-service
VITE_API_BEARER_TOKEN=replace-with-evaluation-token
